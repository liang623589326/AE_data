plot([0 6], [0 150], 'b:', 'LineWidth', 1.5, ...
    'HandleVisibility', 'off');
plot([0 6], [0 24], 'c-.', 'LineWidth', 1.5, ...
    'HandleVisibility', 'off');
plot([0 6], [0 6], 'g-', 'LineWidth', 3, ...

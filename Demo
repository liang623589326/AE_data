plot([0 6], [0 2.4], 'r--', 'LineWidth', 3, ...
    'HandleVisibility', 'off');
plot([0 6], [0 0.9], 'm:', 'LineWidth', 3, ...
    'HandleVisibility', 'off');

formatAxes();

xlabel('\fontname{Times New Roman}\fontsize{20}RA (ms/V)');
ylabel('\fontname{Times New Roman}\fontsize{20}AF (kHz)');

legend({'Tension', 'Shear', 'SPC-SVM'}, ...
    'Location', 'northeast', 'Box', 'off');

axis square;

exportgraphics(gca, fullfile(outputDir, 'kmeans-RA-AF1.jpg'), ...
    'Resolution', 300);

%% 13. Local plotting function
function formatAxes()
    set(gca, ...
        'XLim', [0 10], ...
        'XTick', 0:2:10, ...
        'YLim', [0 300], ...
        'YTick', 0:50:300, ...
        'FontName', 'Times New Roman', ...
        'FontSize', 20, ...
        'LineWidth', 2, ...
        'YColor', 'k');
    box on;
end
